# Variables para docker-compose.yml. En el servidor esto se llamará ".env"
# (mismo directorio que docker-compose.yml) — docker compose lo carga solo.
#
# En producción este archivo lo va a generar un script leyendo el Secret de
# AWS Secrets Manager (Fase 4 de la migración), no se edita a mano en el
# servidor — este ".env.compose.example" es solo la referencia de qué llaves
# espera el compose.

# Mongo (contenedor self-hosted "mongo")
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia_esto_por_una_contraseña_larga_y_unica

# Backend
PORT=4000
MONGO_URI=mongodb://admin:cambia_esto_por_una_contraseña_larga_y_unica@mongo:27017/assets-manager?authSource=admin
JWT_SECRET=cambia_esto_por_un_secreto_seguro
FRONTEND_URL=https://activos.eup.com.mx
GMAIL_VAULT_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sistemas.3@selectshop.com.mx

# Frontend (se hornea en el build, es la llave PUBLICA de VAPID — no es secreta)
VITE_VAPID_PUBLIC_KEY=
