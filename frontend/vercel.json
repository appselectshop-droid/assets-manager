{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://activos.eup.com.mx/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/mesa-de-ayuda", "destination": "/mesa-de-ayuda.html" },
    { "source": "/mesa-de-ayuda/:path*", "destination": "/mesa-de-ayuda.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/deploy-tags.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
